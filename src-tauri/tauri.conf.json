{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "SIBOS",
	"version": "0.1.0",
	"identifier": "id.sibos.app",
	"build": {
		"beforeBuildCommand": "bun run generate",
		"frontendDist": "../.output/public",
		"beforeDevCommand": "bun run dev --port 3210 --host 127.0.0.1",
		"devUrl": "http://127.0.0.1:3210"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "SIBOS",
				"width": 1366,
				"height": 768,
				"minWidth": 1100,
				"minHeight": 640,
				"resizable": true,
				"center": true,
				"maximized": true
			}
		],
		"security": {
			"csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"category": "Finance",
		"shortDescription": "Pendamping ARKAS untuk SPJ BOSP",
		"longDescription": "SIBOS membaca database ARKAS (hanya baca) untuk menyusun buku kas, laporan, dan bukti SPJ BOSP.",
		"copyright": "",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"webviewInstallMode": {
				"type": "embedBootstrapper"
			},
			"nsis": {
				"languages": ["Indonesian", "English"],
				"installMode": "currentUser",
				"installerIcon": "icons/icon.ico"
			}
		}
	}
}
